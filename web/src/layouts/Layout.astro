---
// Layout.astro — the SEO-optimized base layout (meta, canonical, JSON-LD, 0-JS)
interface Props {
  title: string;
  description: string;
  canonical?: string;
  jsonLd?: any;
}
const { title, description, canonical, jsonLd } = Astro.props;
const canonicalUrl = canonical || new URL(Astro.url.pathname, Astro.site).toString();
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  <link rel="canonical" href={canonicalUrl} />
  <!-- structured data for agents/search engines -->
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <style>
    body { font-family: system-ui, sans-serif; max-width: 800px; margin: 0 auto; padding: 1.5rem; color: #1a1a1a; }
    a { color: #0a58ca; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #ddd; padding: .4rem .6rem; text-align: left; font-size: .9rem; }
    th { background: #f5f5f5; }
    .pill { display: inline-block; padding: .1rem .5rem; border-radius: 999px; font-size: .75rem; margin-right: .3rem; }
    .free { background: #e6f4ea; }
    .paid { background: #eef; }
    footer { margin-top: 2rem; border-top: 1px solid #ddd; padding-top: .8rem; font-size: .8rem; color: #666; }
  </style>
</head>
<body>
  <header><h1>{title}</h1></header>
  <main><slot /></main>
  <footer>Pāṭala Deal Radar — live LLM pricing + quality. Data from models.dev / OpenRouter / LiteLLM / free-tier registries.</footer>
</body>
</html>
