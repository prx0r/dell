---
import Layout from '../layouts/Layout.astro';
import { readFileSync, existsSync, readdirSync } from 'fs';
import { join } from 'path';

// Load MANIFEST
const manifestPath = join(process.cwd(), '..', 'MANIFEST.json');
let manifest = {};
if (existsSync(manifestPath)) {
  manifest = JSON.parse(readFileSync(manifestPath, 'utf-8'));
}

// Load snapshots for legacy display
const snapshotsDir = join(process.cwd(), '..', 'snapshots');
let allOffers = [];
if (existsSync(snapshotsDir)) {
  for (const f of readdirSync(snapshotsDir)) {
    if (f.endsWith('.json')) {
      try { allOffers = allOffers.concat(JSON.parse(readFileSync(join(snapshotsDir, f), 'utf-8')).offers || []); } catch {}
    }
  }
}

const free = allOffers.filter(o => o.free);
const providers = [...new Set(allOffers.map(o => o.provider_id))];
const mega = allOffers.filter(o => (o.metadata?.capacity_ratio_vs_median || 0) >= 3 || (o.metadata?.multiplier || 0) >= 2);
const topFree = free.filter(o => o.context_tokens).sort((a,b) => (b.context_tokens||0) - (a.context_tokens||0)).slice(0, 10);
const topPaid = allOffers.filter(o => !o.free && o.input_per_m > 0).sort((a,b) => (a.input_per_m||999) - (b.input_per_m||999)).slice(0, 10);
---
<Layout title="Dell — LLM Inference Economics Oracle" description="Trustworthy, machine-readable inference-economics data for LLM routing and cost optimization.">
  <header>
    <h1>Dell</h1>
    <p class="subtitle">LLM Inference Economics Oracle</p>
    <p class="stats">
      <strong>{manifest.stats?.offers || allOffers.length}</strong> models · 
      <strong>{manifest.stats?.providers || providers.length}</strong> providers · 
      <strong>{manifest.stats?.endpoints || 0}</strong> endpoints · 
      <strong>{manifest.proof_kernel || '14/14'}</strong> proof kernel
    </p>
  </header>

  <section class="hero">
    <h2>Trustworthy Inference Data</h2>
    <p>Every fact traceable to evidence. Every uncertainty represented honestly.</p>
    <div class="cta">
      <a href="/v1/resolve" class="primary">POST /v1/resolve</a>
      <a href="/docs/API" class="secondary">API Docs</a>
    </div>
  </section>

  <section class="features">
    <h2>What Dell Provides</h2>
    <div class="grid">
      <div class="card">
        <h3>🔍 Verified Data</h3>
        <p>Every claim backed by evidence. Provenance chain from source to API.</p>
      </div>
      <div class="card">
        <h3>🎯 Task-Aware Scoring</h3>
        <p>Recommendations based on your workload, not generic rankings.</p>
      </div>
      <div class="card">
        <h3>💰 Cost Optimization</h3>
        <p>Find the cheapest route that meets your requirements.</p>
      </div>
      <div class="card">
        <h3>🤖 Agent-Ready</h3>
        <p>MCP tools for autonomous agents. Machine-readable decisions.</p>
      </div>
    </div>
  </section>

  <section class="mega-deals">
    <h2>Mega Deals</h2>
    {mega.length === 0 ? <p>No mega deals detected.</p> : (
      <table>
        <thead><tr><th>MODEL</th><th>PROVIDER</th><th>DEAL</th><th>CTX</th></tr></thead>
        <tbody>
        {mega.slice(0, 5).map(o => (
          <tr>
            <td>{o.model_id?.split('/').pop()}</td>
            <td>{o.provider_id}</td>
            <td>{o.metadata?.capacity_ratio_vs_median ? `${o.metadata.capacity_ratio_vs_median}x capacity` : o.metadata?.multiplier ? `${o.metadata.multiplier}x usage` : ''}</td>
            <td>{o.context_tokens ? `${(o.context_tokens/1000).toFixed(0)}K` : '-'}</td>
          </tr>
        ))}
        </tbody>
      </table>
    )}
  </section>

  <section class="free-models">
    <h2>Best Free Models</h2>
    <table>
      <thead><tr><th>MODEL</th><th>PROVIDER</th><th>CTX</th><th>TOOLS</th></tr></thead>
      <tbody>
      {topFree.map(o => (
        <tr>
          <td>{o.model_id?.split('/').pop()}</td>
          <td>{o.provider_id}</td>
          <td>{o.context_tokens ? `${(o.context_tokens/1000).toFixed(0)}K` : '-'}</td>
          <td>{o.metadata?.tool_call ? '✅' : '—'}</td>
        </tr>
      ))}
      </tbody>
    </table>
  </section>

  <section class="cheapest">
    <h2>Cheapest Paid</h2>
    <table>
      <thead><tr><th>MODEL</th><th>PROVIDER</th><th>$/M tokens</th><th>CTX</th></tr></thead>
      <tbody>
      {topPaid.map(o => (
        <tr>
          <td>{o.model_id?.split('/').pop()}</td>
          <td>{o.provider_id}</td>
          <td>${o.input_per_m?.toFixed(4)}</td>
          <td>{o.context_tokens ? `${(o.context_tokens/1000).toFixed(0)}K` : '-'}</td>
        </tr>
      ))}
      </tbody>
    </table>
  </section>

  <section class="api">
    <h2>API</h2>
    <div class="endpoints">
      <code>POST /v1/resolve</code>
      <code>GET /v1/routes</code>
      <code>GET /v1/models</code>
      <code>GET /v1/providers</code>
      <code>GET /v1/deals</code>
      <code>GET /v1/free</code>
      <code>GET /v1/workhorses</code>
      <code>GET /v1/high-value</code>
      <code>GET /v1/evidence/:id</code>
      <code>GET /v1/coverage</code>
    </div>
    <p class="mcp">MCP: resolve_inference · search_routes · compare_routes · explain_route · get_deal_changes · get_provider_setup · get_dataset_stats · plan_free_workload · list_models</p>
  </section>

  <section class="trust">
    <h2>Trust Model</h2>
    <ul>
      <li>✅ Every fact traceable to evidence</li>
      <li>✅ Every uncertainty represented honestly</li>
      <li>✅ 14/14 proof kernel gates</li>
      <li>✅ 100% mutation kill rate</li>
      <li>✅ Cryptographic provenance</li>
    </ul>
    <p class="note">Dell provides evidence-based confidence levels, not guarantees.</p>
  </section>

  <footer>
    <p>Version {manifest.version || '1.0.0'} · Schema {manifest.schema_version || 7} · <a href="/docs/API">API Docs</a></p>
  </footer>
</Layout>

<style>
  .subtitle { color: #666; font-size: 1.2em; }
  .stats { color: #444; }
  .hero { text-align: center; padding: 2rem 0; }
  .cta { margin-top: 1rem; }
  .cta a { margin: 0 0.5rem; padding: 0.5rem 1rem; text-decoration: none; border-radius: 4px; }
  .cta .primary { background: #007bff; color: white; }
  .cta .secondary { border: 1px solid #007bff; color: #007bff; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin: 1rem 0; }
  .card { border: 1px solid #ddd; padding: 1rem; border-radius: 8px; }
  .card h3 { margin-top: 0; }
  table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
  th, td { padding: 0.5rem; text-align: left; border-bottom: 1px solid #ddd; }
  th { background: #f5f5f5; }
  .endpoints { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0; }
  .endpoints code { background: #f0f0f0; padding: 0.25rem 0.5rem; border-radius: 4px; }
  .mcp { color: #666; font-size: 0.9em; }
  .note { color: #666; font-style: italic; }
  section { margin: 2rem 0; }
  footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #ddd; color: #666; }
</style>
