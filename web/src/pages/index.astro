---
import Layout from '../layouts/Layout.astro';
import { readFileSync, existsSync } from 'fs';
import { join } from 'path';

// Load data from canonical DB at build time
const dataDir = join(process.cwd(), '..', 'data');
let offers = [];
let stats = { total: 0, free: 0, providers: 0 };

if (existsSync(join(dataDir, 'llmdeals.sqlite3'))) {
  // Try to read snapshot exports
  const snapshotsDir = join(process.cwd(), '..', 'snapshots');
  if (existsSync(snapshotsDir)) {
    const { readdirSync } = await import('fs');
    for (const f of readdirSync(snapshotsDir)) {
      if (f.endsWith('.json')) {
        try {
          const data = JSON.parse(readFileSync(join(snapshotsDir, f), 'utf-8'));
          offers = offers.concat(data.offers || []);
        } catch {}
      }
    }
  }
}

const freeOffers = offers.filter(o => o.free);
const providers = [...new Set(offers.map(o => o.provider_id))];
const megaDeals = offers.filter(o => o.metadata?.capacity_multiplier >= 3 || o.metadata?.multiplier >= 2);

stats = { total: offers.length, free: freeOffers.length, providers: providers.length };
---
<Layout title="LLM Deals" description="Canonical LLM inference deal data layer">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap');
    * { font-family: 'Share Tech Mono', 'Courier New', monospace; margin: 0; padding: 0; }
    body { background: #000; color: #0f0; padding: 20px; max-width: 1200px; margin: 0 auto; }
    h1 { font-size: 1.2em; border-bottom: 1px solid #0f0; padding-bottom: 5px; }
    h2 { font-size: 1em; color: #0a0; margin-top: 20px; }
    .stat { display: inline-block; margin-right: 20px; }
    .stat-num { font-size: 1.5em; color: #0f0; }
    .stat-label { font-size: 0.8em; color: #0a0; }
    table { width: 100%; border-collapse: collapse; margin: 10px 0; font-size: 0.85em; }
    th, td { padding: 4px 8px; text-align: left; border-bottom: 1px solid #111; }
    th { color: #0a0; }
    .mega { color: #ff0; }
    .free { color: #0ff; }
    .ctx { color: #888; }
    a { color: #0f0; text-decoration: none; }
    a:hover { text-decoration: underline; }
    .api { background: #111; padding: 10px; margin: 10px 0; font-size: 0.85em; }
    code { background: #111; padding: 2px 4px; }
  </style>

  <h1>LLM DEALS // CANONICAL DATA LAYER</h1>

  <div>
    <span class="stat"><span class="stat-num">{stats.total}</span> <span class="stat-label">MODELS</span></span>
    <span class="stat"><span class="stat-num free">{stats.free}</span> <span class="stat-label">FREE</span></span>
    <span class="stat"><span class="stat-num">{stats.providers}</span> <span class="stat-label">PROVIDERS</span></span>
    <span class="stat"><span class="stat-num mega">{megaDeals.length}</span> <span class="stat-label">MEGA DEALS</span></span>
  </div>

  <h2>// MEGA DEALS</h2>
  {megaDeals.length === 0 ? (
    <p class="ctx">No mega deals detected.</p>
  ) : (
    <table>
      <tr><th>MODEL</th><th>PROVIDER</th><th>MULTIPLIER</th><th>CTX</th></tr>
      {megaDeals.slice(0, 10).map(o => (
        <tr class="mega">
          <td>{o.model_id?.split('/').pop()}</td>
          <td>{o.provider_id}</td>
          <td>{o.metadata?.capacity_multiplier ? `${o.metadata.capacity_multiplier}x CAPACITY` : o.metadata?.multiplier ? `${o.metadata.multiplier}x USAGE` : ''}</td>
          <td class="ctx">{o.context_tokens ? `${(o.context_tokens/1000).toFixed(0)}K` : '-'}</td>
        </tr>
      ))}
    </table>
  )}

  <h2>// FREE MODELS (TOP 20)</h2>
  <table>
    <tr><th>MODEL</th><th>PROVIDER</th><th>CTX</th><th>RPD</th></tr>
    {freeOffers.slice(0, 20).map(o => (
      <tr>
        <td class="free">{o.model_id?.split('/').pop()}</td>
        <td>{o.provider_id}</td>
        <td class="ctx">{o.context_tokens ? `${(o.context_tokens/1000).toFixed(0)}K` : '-'}</td>
        <td>{o.requests_per_day || '-'}</td>
      </tr>
    ))}
  </table>

  <h2>// ALL PROVIDERS ({providers.length})</h2>
  <p class="ctx">{providers.join(', ')}</p>

  <div class="api">
    <h2>// API</h2>
    <p><code>GET /v1/deals</code> <code>GET /v1/deals/free</code> <code>GET /v1/mega-deals</code></p>
    <p><code>GET /v1/models</code> <code>GET /v1/providers</code> <code>GET /v1/recommend</code></p>
    <p><code>GET /v1/glossary</code> <code>GET /v1/probe</code> <code>GET /v1/history</code></p>
  </div>
</Layout>
