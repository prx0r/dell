---
import Layout from '../layouts/Layout.astro';
import { readFileSync, existsSync, readdirSync } from 'fs';
import { join } from 'path';

const manifestPath = join(process.cwd(), '..', 'MANIFEST.json');
let manifest = {};
if (existsSync(manifestPath)) {
  manifest = JSON.parse(readFileSync(manifestPath, 'utf-8'));
}

const snapshotsDir = join(process.cwd(), '..', 'snapshots');
let allOffers = [];
if (existsSync(snapshotsDir)) {
  for (const f of readdirSync(snapshotsDir)) {
    if (f.endsWith('.json')) {
      try { allOffers = allOffers.concat(JSON.parse(readFileSync(join(snapshotsDir, f), 'utf-8')).offers || []); } catch {}
    }
  }
}

const free = allOffers.filter(o => o.free);
const providers = [...new Set(allOffers.map(o => o.provider_id))];
const mega = allOffers.filter(o => (o.metadata?.multiplier || 0) >= 2);
const topFree = free.filter(o => o.context_tokens).sort((a,b) => (b.context_tokens||0) - (a.context_tokens||0)).slice(0, 8);
const topPaid = allOffers.filter(o => !o.free && o.input_per_m > 0).sort((a,b) => (a.input_per_m||999) - (b.input_per_m||999)).slice(0, 8);
---
<Layout title="Dell — LLM Inference Economics" description="Find the cheapest, fastest, or best LLM route for your workload.">
  <main>
    <section class="hero">
      <h1>Dell</h1>
      <p class="tagline">Which model should I use?</p>
      <div class="stats-row">
        <span><strong>{manifest.stats?.offers || allOffers.length}</strong> models</span>
        <span>·</span>
        <span><strong>{manifest.stats?.providers || providers.length}</strong> providers</span>
        <span>·</span>
        <span><strong>{mega.length}</strong> deals</span>
      </div>
    </section>

    <section class="query-box">
      <h2>Quick Find</h2>
      <div class="query-examples">
        <code>POST /v1/resolve</code>
        <pre>{`{
  "workload": { "task": "coding" },
  "constraints": {
    "tools": "required",
    "context_tokens": { "min": 64000 }
  },
  "preferences": { "optimize": "cost" }
}`}</pre>
      </div>
    </section>

    {mega.length > 0 && (
      <section class="deals">
        <h2>🔥 Mega Deals</h2>
        <table>
          <thead><tr><th>Model</th><th>Provider</th><th>Deal</th><th>Context</th></tr></thead>
          <tbody>
          {mega.slice(0, 5).map(o => (
            <tr>
              <td><strong>{o.model_id?.split('/').pop()}</strong></td>
              <td>{o.provider_id}</td>
              <td class="deal-badge">{o.metadata?.multiplier}x usage</td>
              <td>{o.context_tokens ? `${(o.context_tokens/1000).toFixed(0)}K` : '—'}</td>
            </tr>
          ))}
          </tbody>
        </table>
      </section>
    )}

    <section class="two-col">
      <div class="col">
        <h2>Best Free</h2>
        <table>
          <thead><tr><th>Model</th><th>Context</th></tr></thead>
          <tbody>
          {topFree.map(o => (
            <tr>
              <td>{o.model_id?.split('/').pop()}</td>
              <td>{o.context_tokens ? `${(o.context_tokens/1000).toFixed(0)}K` : '—'}</td>
            </tr>
          ))}
          </tbody>
        </table>
      </div>
      <div class="col">
        <h2>Cheapest Paid</h2>
        <table>
          <thead><tr><th>Model</th><th>$/M</th></tr></thead>
          <tbody>
          {topPaid.map(o => (
            <tr>
              <td>{o.model_id?.split('/').pop()}</td>
              <td>${o.input_per_m?.toFixed(4)}</td>
            </tr>
          ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="api-box">
      <h2>API</h2>
      <div class="endpoints">
        <span class="method">POST</span> <code>/v1/resolve</code>
        <span class="method">GET</span> <code>/v1/models</code>
        <span class="method">GET</span> <code>/v1/free</code>
        <span class="method">GET</span> <code>/v1/deals</code>
        <span class="method">GET</span> <code>/v1/providers</code>
      </div>
      <p class="mcp-note">MCP available · 9 tools · Agent-ready</p>
    </section>

    <footer>
      <p>v{manifest.version || '1.0'} · {manifest.stats?.offers || '—'} models · <a href="/docs/API">Docs</a></p>
    </footer>
  </main>
</Layout>

<style>
  main { max-width: 720px; margin: 0 auto; padding: 2rem 1rem; }
  .hero { text-align: center; margin-bottom: 2rem; }
  .tagline { color: #666; font-size: 1.1em; margin: 0.5rem 0; }
  .stats-row { display: flex; gap: 0.5rem; justify-content: center; color: #444; font-size: 0.95em; }
  
  .query-box { background: #f8f9fa; border-radius: 8px; padding: 1.5rem; margin: 2rem 0; }
  .query-box h2 { margin-top: 0; font-size: 1.1em; }
  .query-examples code { background: #e9ecef; padding: 0.2rem 0.4rem; border-radius: 3px; font-size: 0.85em; }
  .query-examples pre { background: #1a1a1a; color: #f8f9fa; padding: 1rem; border-radius: 6px; overflow-x: auto; font-size: 0.85em; margin-top: 0.5rem; }
  
  .deals { background: #fff3cd; border-radius: 8px; padding: 1.5rem; margin: 2rem 0; }
  .deals h2 { margin-top: 0; font-size: 1.1em; }
  .deal-badge { background: #ffc107; color: #000; padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.85em; font-weight: 600; }
  
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin: 2rem 0; }
  @media (max-width: 600px) { .two-col { grid-template-columns: 1fr; } }
  .two-col h2 { font-size: 1.1em; }
  
  table { width: 100%; border-collapse: collapse; font-size: 0.9em; }
  th, td { padding: 0.4rem 0.6rem; text-align: left; border-bottom: 1px solid #eee; }
  th { color: #666; font-weight: 500; }
  td:first-child { font-weight: 500; }
  
  .api-box { background: #f8f9fa; border-radius: 8px; padding: 1.5rem; margin: 2rem 0; }
  .api-box h2 { margin-top: 0; font-size: 1.1em; }
  .endpoints { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
  .method { background: #198754; color: white; padding: 0.15rem 0.4rem; border-radius: 3px; font-size: 0.75em; font-weight: 600; }
  .endpoints code { background: #e9ecef; padding: 0.2rem 0.4rem; border-radius: 3px; font-size: 0.85em; }
  .mcp-note { color: #666; font-size: 0.85em; margin-top: 0.5rem; }
  
  footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #eee; color: #666; font-size: 0.85em; text-align: center; }
  footer a { color: #0a58ca; }
</style>
