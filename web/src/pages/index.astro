---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = sortedPosts[0];
const recent = sortedPosts.slice(1, 5);
---
<Layout title="Dell — LLM Deal Intelligence" description="Timestamped deal analysis for LLM inference. When a model changes price, quota, or capability, we document it.">
  <main>
    <section class="hero">
      <h1>Dell</h1>
      <p class="tagline">LLM deal analysis, timestamped. When something changes, we document it.</p>
      <div class="stats-row">
        <span><strong>{sortedPosts.length}</strong> analyses</span>
        <span>·</span>
        <span>auto-generated by <code>fx</code> skill</span>
        <span>·</span>
        <span>via Hermes cron</span>
      </div>
    </section>

    {latest && (
      <section class="latest">
        <h2>Latest Analysis</h2>
        <article class="post-card featured">
          <time>{latest.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          <h3><a href={`/blog/${latest.slug}`}>{latest.data.title}</a></h3>
          <p>{latest.data.description}</p>
          <div class="tags">
            {latest.data.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </article>
      </section>
    )}

    {recent.length > 0 && (
      <section class="recent">
        <h2>Recent</h2>
        {recent.map(post => (
          <article class="post-card">
            <time>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            <h3><a href={`/blog/${post.slug}`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
          </article>
        ))}
      </section>
    )}

    <section class="how">
      <h2>How This Works</h2>
      <ol>
        <li><strong>Cron detects</strong> a deal change (price, multiplier, free tier, context window)</li>
        <li><strong><code>fx</code> skill analyzes</strong> — 7 research passes, value scoring, routing recommendation</li>
        <li><strong>Blog post published</strong> — timestamped, structured, actionable</li>
        <li><strong>Agents consume</strong> via RSS, MCP, or REST API</li>
      </ol>
    </section>

    <section class="subscribe">
      <h2>Subscribe</h2>
      <p>New analyses appear on the <a href="/rss.xml">RSS feed</a> and via MCP tools.</p>
      <div class="endpoints">
        <code>GET /rss.xml</code>
        <code>MCP: find_inference_deals</code>
        <code>MCP: explain_deal</code>
      </div>
    </section>
  </main>
</Layout>

<style>
  main { max-width: 720px; margin: 0 auto; padding: 2rem 1rem; }
  .hero { text-align: center; margin-bottom: 2rem; }
  .tagline { color: #666; font-size: 1.1em; margin: 0.5rem 0; }
  .stats-row { display: flex; gap: 0.5rem; justify-content: center; color: #444; font-size: 0.9em; flex-wrap: wrap; }
  .stats-row code { background: #e9ecef; padding: 0.1rem 0.3rem; border-radius: 3px; font-size: 0.85em; }

  section { margin: 2rem 0; }
  h2 { font-size: 1.1em; color: #333; border-bottom: 1px solid #eee; padding-bottom: 0.3rem; }

  .post-card { background: #f8f9fa; border-radius: 8px; padding: 1.5rem; margin: 1rem 0; }
  .post-card.featured { background: #fff3cd; border-left: 4px solid #ffc107; }
  time { color: #666; font-size: 0.85em; }
  h3 { margin: 0.5rem 0; font-size: 1.2em; }
  h3 a { color: #1a1a1a; text-decoration: none; }
  h3 a:hover { color: #0a58ca; }
  p { color: #444; line-height: 1.6; margin: 0.5rem 0; }
  .tags { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.75rem; }
  .tag { background: #e9ecef; color: #495057; padding: 0.2rem 0.6rem; border-radius: 12px; font-size: 0.8em; }

  .recent .post-card { padding: 1rem 1.5rem; }
  .recent h3 { font-size: 1.05em; }

  .how ol { padding-left: 1.5rem; }
  .how li { margin: 0.5rem 0; color: #444; line-height: 1.5; }
  .how code { background: #e9ecef; padding: 0.1rem 0.3rem; border-radius: 3px; font-size: 0.9em; }

  .subscribe { background: #f8f9fa; border-radius: 8px; padding: 1.5rem; }
  .subscribe p { margin: 0.5rem 0; }
  .endpoints { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.75rem; }
  .endpoints code { background: #e9ecef; padding: 0.2rem 0.5rem; border-radius: 3px; font-size: 0.85em; }
</style>
