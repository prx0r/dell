---
import Layout from '../layouts/Layout.astro';
import { readFileSync, existsSync, readdirSync } from 'fs';
import { join } from 'path';

const snapshotsDir = join(process.cwd(), '..', 'snapshots');
let allOffers = [];
if (existsSync(snapshotsDir)) {
  for (const f of readdirSync(snapshotsDir)) {
    if (f.endsWith('.json')) {
      try { allOffers = allOffers.concat(JSON.parse(readFileSync(join(snapshotsDir, f), 'utf-8')).offers || []); } catch {}
    }
  }
}
const free = allOffers.filter(o => o.free);
const providers = [...new Set(allOffers.map(o => o.provider_id))];
const mega = allOffers.filter(o => (o.metadata?.capacity_ratio_vs_median || 0) >= 3 || (o.metadata?.multiplier || 0) >= 2);
const topFree = free.filter(o => o.context_tokens).sort((a,b) => (b.context_tokens||0) - (a.context_tokens||0)).slice(0, 15);
const topPaid = allOffers.filter(o => !o.free && o.input_per_m > 0).sort((a,b) => (a.input_per_m||999) - (b.input_per_m||999)).slice(0, 15);
---
<Layout title="LLM Deals" description="Canonical LLM inference data layer">
  <h1>LLM Deals</h1>
  <p>Live, verifiable, machine-readable data about LLM inference opportunities.</p>

  <p><strong>{allOffers.length}</strong> models · <strong>{free.length}</strong> free · <strong>{providers.length}</strong> providers · <strong>{mega.length}</strong> mega deals</p>

  <h2>Mega Deals</h2>
  {mega.length === 0 ? <p>No mega deals detected.</p> : (
    <table><tr><th>MODEL</th><th>PROVIDER</th><th>WHY</th><th>CTX</th></tr>
    {mega.slice(0, 8).map(o => (
      <tr><td>{o.model_id?.split('/').pop()}</td><td>{o.provider_id}</td>
      <td>{o.metadata?.capacity_ratio_vs_median ? `${o.metadata.capacity_ratio_vs_median}x CAPACITY` : o.metadata?.multiplier ? `${o.metadata.multiplier}x USAGE` : ''}</td>
      <td>{o.context_tokens ? `${(o.context_tokens/1000).toFixed(0)}K` : '-'}</td></tr>
    ))}</table>
  )}

  <h2>Best Free Models</h2>
  <table><tr><th>MODEL</th><th>PROVIDER</th><th>CTX</th><th>TOOL</th></tr>
  {topFree.map(o => (
    <tr><td>{o.model_id?.split('/').pop()}</td><td>{o.provider_id}</td>
    <td>{o.context_tokens ? `${(o.context_tokens/1000).toFixed(0)}K` : '-'}</td>
    <td>{o.metadata?.tool_call ? 'Y' : '?'}</td></tr>
  ))}</table>

  <h2>Cheapest Paid</h2>
  <table><tr><th>MODEL</th><th>PROVIDER</th><th>$/M</th><th>CTX</th></tr>
  {topPaid.map(o => (
    <tr><td>{o.model_id?.split('/').pop()}</td><td>{o.provider_id}</td>
    <td>${o.input_per_m?.toFixed(3)}</td>
    <td>{o.context_tokens ? `${(o.context_tokens/1000).toFixed(0)}K` : '-'}</td></tr>
  ))}</table>

  <h2>Providers</h2>
  <p>{providers.join(', ')}</p>

  <h2>API</h2>
  <p><code>/v1/models</code> <code>/v1/deals</code> <code>/v1/deals/hot</code> <code>/v1/free</code> <code>/v1/recommend</code> <code>/v1/mega-deals</code> <code>/v1/glossary</code> <code>/v1/stats</code></p>
  <p>MCP: find_inference_deals · get_free_models · get_providers · get_provider_setup · get_best_by_badge · recommend_model · get_deal_changes · explain_deal · get_dataset_stats</p>
</Layout>
